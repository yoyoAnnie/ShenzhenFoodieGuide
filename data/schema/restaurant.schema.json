{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restaurant",
  "type": "object",
  "required": ["id", "name_zh", "district", "occasions", "food_items", "hours_verified_on"],
  "properties": {
    "id": {"type": "string"},
    "name_zh": {"type": "string"},
    "name_en": {"type": "string"},
    "district": {"type": "string"},
    "address": {"type": "string"},
    "lat": {"type": "number"},
    "lng": {"type": "number"},
    "price_per_head_cny": {"type": "number"},
    "hours": {"type": "string"},
    "hours_verified_on": {"type": "string", "format": "date"},
    "occasions": {"type": "array", "items": {"type": "string"}},
    "food_items": {"type": "array", "items": {"type": "string"}},
    "taste_scores_0_5": {"type": "object"},
    "insider_note": {"type": "string"},
    "source": {"type": "string", "enum": ["visited", "contributor", "hearsay"]}
  }
}
